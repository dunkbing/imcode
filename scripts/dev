#!/bin/sh
# ui checks without a window, on scratch data (never your own folders, HOME or ~/.claude):
#   scripts/dev list                      the scenarios (tests/ui/scenarios/*.scn)
#   scripts/dev shot <name> [out.png]     run one, write its screenshot (default: ./<name>.png)
#   scripts/dev check                     run them all against tests/ui/golden/<name>.png
#   scripts/dev check --update            ... and keep what they show as the new golden files
# BUILD=<dir> picks the build folder (default build). a scenario is a file of variables:
#   DEV (IMCODE_DEV), INPUT (IMCODE_INPUT: "<frame> click X Y;<frame> type text;..."), FRAMES, WINDOW,
#   FILES (made in the project folder), HOST (a project on that ssh host: needs IMCODE_DEV_HOST
#   and links ~/.ssh into the scratch HOME, so it is skipped by check), @DIR@ in INPUT = the folder
set -eu
root=$(cd "$(dirname "$0")/.." && pwd)
build=${BUILD:-$root/build}
scn=$root/tests/ui/scenarios
golden=$root/tests/ui/golden

run() { # <name> <out.png>: one scenario
    name=$1
    out=$2
    unset DEV INPUT FRAMES WINDOW FILES HOST
    . "$scn/$name.scn"
    work=$(mktemp -d "${TMPDIR:-/tmp}/imcode-dev.XXXXXX")
    trap 'rm -rf "$work"' EXIT
    mkdir -p "$work/scn/p" "$work/home" "$work/data"
    for f in ${FILES:-}; do
        mkdir -p "$work/scn/p/$(dirname "$f")"
        echo "$f" > "$work/scn/p/$f"
    done
    host=""
    if [ -n "${HOST:-}" ]; then
        host=${IMCODE_DEV_HOST:?"this scenario needs IMCODE_DEV_HOST=<user@host>"}
        ln -s "$HOME/.ssh" "$work/home/.ssh"
    fi
    cwd=$work/scn/p
    [ -n "$host" ] && cwd=${IMCODE_DEV_CWD:-/tmp}
    echo '{"onboarded":true,"agents":[],"machines":[],"machine":"","projects":[{"host":"'"$host"'","cwd":"'"$cwd"'"}],"threads":[],"last":""}' > "$work/data/threads.json"
    input=$(printf '%s' "${INPUT:-}" | sed "s#@DIR@#$work/scn/p#g")
    HOME=$work/home IMCODE_DATA_DIR=$work/data IMCODE_AGENT_CMD=$build/external/acp-cpp/acp-echo-agent \
        IMCODE_WINDOW=${WINDOW:-1300x700} IMCODE_SHOT=$work/shot.ppm IMCODE_SHOT_FRAMES=${FRAMES:-40} \
        IMCODE_DEV=${DEV:-new} IMCODE_INPUT=$input "$build/imcode" > /dev/null 2>&1 || true
    [ -s "$work/shot.ppm" ] || { echo "$name: no screenshot (is $build/imcode built?)" >&2; return 1; }
    magick "$work/shot.ppm" -define png:compression-level=9 -strip "${fmt:-}$out"
    rm -rf "$work"
    trap - EXIT
}

names() { for f in "$scn"/*.scn; do basename "$f" .scn; done; }

case ${1:-} in
list) names ;;
shot)
    name=${2:?"scripts/dev shot <name> [out.png]"}
    run "$name" "${3:-$name.png}"
    echo "${3:-$name.png}"
    ;;
check)
    fmt=PNG8:
    update=no
    [ "${2:-}" = "--update" ] && update=yes
    shots=$(mktemp -d "${TMPDIR:-/tmp}/imcode-dev-shots.XXXXXX")
    failed=0
    for name in $(names); do
        if grep -q '^HOST=' "$scn/$name.scn"; then
            echo "skip $name (needs a host)"
            continue
        fi
        run "$name" "$shots/$name.png" || { failed=1; continue; }
        if [ "$update" = yes ]; then
            cp "$shots/$name.png" "$golden/$name.png"
            echo "updated $name"
        elif [ ! -f "$golden/$name.png" ]; then
            echo "FAIL $name: no golden file (scripts/dev check --update)"
            failed=1
        else
            # a few pixels of tolerance: antialiasing, not layout
            diff=$(magick compare -metric AE -fuzz 2% "$shots/$name.png" "$golden/$name.png" null: 2>&1 || true)
            diff=${diff%% *}
            if [ "$diff" -le 200 ] 2> /dev/null; then
                echo "ok   $name"
            else
                mkdir -p "$build/ui-actual" && cp "$shots/$name.png" "$build/ui-actual/$name.png"
                echo "FAIL $name: $diff pixels differ (see $build/ui-actual/$name.png)"
                failed=1
            fi
        fi
    done
    rm -rf "$shots"
    exit $failed
    ;;
*)
    sed -n '2,10p' "$0" | sed 's/^# \{0,1\}//'
    exit 2
    ;;
esac
