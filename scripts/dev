#!/bin/sh
# ui checks without a window, on scratch data (never your own folders, HOME or ~/.claude):
#   scripts/dev list                      the scenarios (tests/ui/scenarios/*.scn)
#   scripts/dev shot <name> [out.png]     run one, write its screenshot (default: ./<name>.png)
#   scripts/dev check                     run them all against tests/ui/golden/<name>.png
#   scripts/dev check --update            ... and keep what they show as the new golden files
# BUILD=<dir> picks the build folder (default build). a scenario is a file of variables:
#   AGENT (the agent command: default the echo agent; tests/ui/silent-agent never answers; $root is the repo), OPTIONS (models the agent offered before),
#   DEV (IMCODE_DEV), INPUT (IMCODE_INPUT: "<frame> click X Y;<frame> type text;..."), FRAMES, WINDOW,
#   STABLE (more frames: the shot taken that many frames later must match the first, so nothing shifts or animates on),
#   DIVIDER (left, or right for the files panel's: where the series check looks), INK (with SERIES: the least ink the transcript area has in any frame, so a blank frame fails),
#   SERIES (the last n frames are kept: the divider must be one line, on the same pixel top to bottom, in every one, and what does not move must not change),
#   SETUP (a shell snippet run in the project folder first), FILES (made in the project folder), HOST (a project on that ssh host: needs IMCODE_DEV_HOST
#   and links ~/.ssh into the scratch HOME, so it is skipped by check), @DIR@ in INPUT = the folder
set -eu
root=$(cd "$(dirname "$0")/.." && pwd)
build=${BUILD:-$root/build}
scn=$root/tests/ui/scenarios
golden=$root/tests/ui/golden

run() { # <name> <out.png> [more frames]: one scenario
    name=$1
    out=$2
    unset DEV INPUT FRAMES WINDOW FILES HOST OPTIONS AGENT STABLE SERIES INK SETUP DIVIDER
    . "$scn/$name.scn"
    FRAMES=$(( ${FRAMES:-40} + ${3:-0} ))
    work=$(mktemp -d "${TMPDIR:-/tmp}/imcode-dev.XXXXXX")
    trap 'rm -rf "$work"' EXIT
    mkdir -p "$work/scn/p" "$work/home" "$work/data"
    for f in ${FILES:-}; do
        mkdir -p "$work/scn/p/$(dirname "$f")"
        echo "$f" > "$work/scn/p/$f"
    done
    # SETUP: a shell snippet run in the project folder first (a git repo with a change, say)
    [ -z "${SETUP:-}" ] || (cd "$work/scn/p" && HOME=$work/home sh -c "$SETUP" > /dev/null 2>&1)
    host=""
    if [ -n "${HOST:-}" ]; then
        host=${IMCODE_DEV_HOST:?"this scenario needs IMCODE_DEV_HOST=<user@host>"}
        ln -s "$HOME/.ssh" "$work/home/.ssh"
    fi
    cwd=$work/scn/p
    [ -n "$host" ] && cwd=${IMCODE_DEV_CWD:-/tmp}
    opts=${OPTIONS:-}
    [ -n "$opts" ] || opts="{}"
    echo '{"onboarded":true,"options":'"$opts"',"agents":[],"machines":[],"machine":"","projects":[{"host":"'"$host"'","cwd":"'"$cwd"'"}],"threads":[],"last":""}' > "$work/data/threads.json"
    input=$(printf '%s' "${INPUT:-}" | sed "s#@DIR@#$work/scn/p#g")
    HOME=$work/home IMCODE_DATA_DIR=$work/data IMCODE_AGENT_CMD=${AGENT:-$build/external/acp-cpp/acp-echo-agent} \
        IMCODE_WINDOW=${WINDOW:-1300x700} IMCODE_SHOT=$work/shot.ppm IMCODE_SHOT_FRAMES=${FRAMES:-40} \
        IMCODE_DEV=${DEV:-new} IMCODE_INPUT=$input IMCODE_SHOT_SERIES=${SERIES:-0} "$build/imcode" > /dev/null 2>&1 || true
    [ -s "$work/shot.ppm" ] || { echo "$name: no screenshot (is $build/imcode built?)" >&2; return 1; }
    magick "$work/shot.ppm" -define png:compression-level=9 -strip "${fmt:-}$out"
    if [ "${SERIES:-0}" -gt 0 ] && [ "${checking:-no}" = yes ]; then
        # the divider is one line: the same pixel on the title bar, the middle and the bottom, in every frame;
        # the corners that do not move with it stay as they are
        w=$(magick identify -format %w "$work/shot.ppm")
        h=$(magick identify -format %h "$work/shot.ppm")
        first="" last=""
        # DIVIDER=right: the files panel's (its colour is on the right of the line; the sidebar's end stays still)
        from=380 side=-3 corner=$((w - 300)) inkx=$((w - 600))
        [ "${DIVIDER:-left}" != right ] || { from=$((w / 2)) side=3 corner=0 inkx=700; }
        for f in "$work"/shot.ppm.*.ppm; do
            xs=""
            for y in 6 $((h / 2)) $((h - 14)); do
                x=$(magick "$f" -crop $((w - from))x1+"$from"+"$y" +repage -depth 8 txt:- | awk -v from="$from" -v rev="${DIVIDER:-left}" 'NR>1{split($1,a,","); split($2,v,/[(,)]/); if(v[2]+v[3]+v[4]>=110){hit=a[1]+from; if(rev!="right"){print hit; exit}}} END{if(rev=="right"&&hit)print hit}')
                xs="$xs ${x:-none}"
            done
            set -- $xs
            if [ "$1" != "$2" ] || [ "$2" != "$3" ]; then
                echo "FAIL $name: the divider is not one line in $(basename "$f"): x =$xs" >&2
                return 1
            fi
            # the sidebar's tone reaches the line in the same frame: just left of it is the sidebar's, not the window's
            for y in 6 $((h / 2)); do
                tone=$(magick "$f" -crop 1x1+$(( $(echo $xs | cut -d' ' -f1) + side ))+"$y" +repage -depth 8 txt:- | awk 'NR>1{split($2,v,/[(,)]/); print v[2]+v[3]+v[4]}')
                if [ "${tone:-0}" -gt 80 ]; then
                    echo "FAIL $name: the sidebar's tone lags the divider in $(basename "$f")" >&2
                    return 1
                fi
            done
            if [ -n "${INK:-}" ]; then
                # the transcript never blinks: some text is in the panel in every frame (a blank frame has ~0)
                ink=$(magick "$f" -crop 560x350+$((inkx))+120 +repage -colorspace Gray -threshold 35% -format '%[fx:int(mean*1000)]' info:)
                if [ "$ink" -lt "$INK" ]; then
                    echo "FAIL $name: the transcript is blank or nearly in $(basename "$f") (ink $ink < $INK)" >&2
                    return 1
                fi
            fi
            [ -n "$first" ] || first=$1
            last=$1
            magick "$f" -crop 300x240+$((corner))+$((h - 300)) +repage "$work/corner.png"
            magick "$f" -crop 300x80+$((corner))+0 +repage "$work/bar.png"
            if [ ! -f "$work/corner0.png" ]; then
                cp "$work/corner.png" "$work/corner0.png"
                cp "$work/bar.png" "$work/bar0.png"
            fi
            moved=$(( $(magick compare -metric AE -fuzz 5% "$work/corner.png" "$work/corner0.png" null: 2>&1 | sed "s/[. ].*//") + $(magick compare -metric AE -fuzz 5% "$work/bar.png" "$work/bar0.png" null: 2>&1 | sed "s/[. ].*//") ))
            if [ "$moved" -gt 60 ]; then
                echo "FAIL $name: the title bar's right end or the composer's corner changed during the drag ($(basename "$f"): $moved pixels)" >&2
                return 1
            fi
        done
        if [ "$first" = "$last" ]; then
            echo "FAIL $name: the divider did not move during the series" >&2
            return 1
        fi
    fi
    rm -rf "$work"
    trap - EXIT
}

names() { for f in "$scn"/*.scn; do basename "$f" .scn; done; }

case ${1:-} in
list) names ;;
shot)
    name=${2:?"scripts/dev shot <name> [out.png]"}
    run "$name" "${3:-$name.png}"
    echo "${3:-$name.png}"
    ;;
check)
    fmt=PNG8:
    checking=yes
    update=no
    [ "${2:-}" = "--update" ] && update=yes
    shots=$(mktemp -d "${TMPDIR:-/tmp}/imcode-dev-shots.XXXXXX")
    failed=0
    for name in $(names); do
        if grep -q '^HOST=' "$scn/$name.scn"; then
            echo "skip $name (needs a host)"
            continue
        fi
        run "$name" "$shots/$name.png" || { failed=1; continue; }
        # layout shifting: the same scenario run for more frames must look the same (a caret blink aside)
        stable=$(sed -n 's/^STABLE=//p' "$scn/$name.scn" | tr -d '"')
        if [ -n "$stable" ] && [ "$update" = no ]; then
            run "$name" "$shots/$name-later.png" "$stable" || { failed=1; continue; }
            moved=$(magick compare -metric AE -fuzz 2% "$shots/$name.png" "$shots/$name-later.png" null: 2>&1 || true)
            moved=${moved%%[. ]*}
            if [ "$moved" -gt 60 ] 2> /dev/null; then
                mkdir -p "$build/ui-actual" && cp "$shots/$name-later.png" "$build/ui-actual/$name-later.png" && cp "$shots/$name.png" "$build/ui-actual/$name.png"
                echo "FAIL $name: $moved pixels moved between the first shot and one $stable frames later (see $build/ui-actual/$name*.png)"
                failed=1
            fi
        fi
        if [ "$update" = yes ]; then
            cp "$shots/$name.png" "$golden/$name.png"
            echo "updated $name"
        elif [ ! -f "$golden/$name.png" ]; then
            echo "FAIL $name: no golden file (scripts/dev check --update)"
            failed=1
        else
            # a few pixels of tolerance: antialiasing, not layout
            diff=$(magick compare -metric AE -fuzz 2% "$shots/$name.png" "$golden/$name.png" null: 2>&1 || true)
            diff=${diff%%[. ]*}
            if [ "$diff" -le 200 ] 2> /dev/null; then
                echo "ok   $name"
            else
                mkdir -p "$build/ui-actual" && cp "$shots/$name.png" "$build/ui-actual/$name.png"
                echo "FAIL $name: $diff pixels differ (see $build/ui-actual/$name.png)"
                failed=1
            fi
        fi
    done
    rm -rf "$shots"
    exit $failed
    ;;
*)
    sed -n '2,10p' "$0" | sed 's/^# \{0,1\}//'
    exit 2
    ;;
esac
